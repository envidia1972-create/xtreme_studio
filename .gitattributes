# Normalizacion de finales de linea para trabajar en Windows y Linux (agregado por DSH)
* text=auto eol=lf

# Binarios: git no debe tocarlos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.aab binary
*.apk binary
*.exe binary
*.dll binary
*.so binary
*.pdf binary

# Scripts de Windows: se quedan en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
